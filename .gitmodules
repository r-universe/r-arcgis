[submodule ".registry"]
	path = .registry
	url = https://github.com/r-arcgis/r-arcgis.r-universe.dev
	branch = HEAD
[submodule "arcgisgeocode"]
	path = arcgisgeocode
	url = https://github.com/r-arcgis/arcgisgeocode
[submodule "arcgislayers"]
	path = arcgislayers
	url = https://github.com/r-arcgis/arcgislayers
[submodule "arcgisplaces"]
	path = arcgisplaces
	url = https://github.com/r-arcgis/arcgisplaces
[submodule "arcgisrouting"]
	path = arcgisrouting
	url = https://github.com/r-arcgis/arcgisrouting
[submodule "arcgisutils"]
	path = arcgisutils
	url = https://github.com/r-arcgis/arcgisutils
[submodule "arcpbf"]
	path = arcpbf
	url = https://github.com/r-arcgis/arcpbf
[submodule "calcite"]
	path = calcite
	url = https://github.com/r-arcgis/calcite
